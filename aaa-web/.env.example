# Postgres (Neon en producción, local en desarrollo)
DATABASE_URL=postgresql://usuario:password@host:5432/aaa_web?sslmode=require

# Acceso a la app. Recomendado: hash bcrypt en base64 para que Next no
# interprete los "$" del hash como variables de entorno.
# Genera el valor con:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync(process.argv[1], 12)).toString('base64'))" 'tu-password'
APP_PASSWORD_HASH_B64=

# Alternativas: hash bcrypt crudo (escapa cada "$" como "\$") o contraseña
# plana solo para desarrollo local.
APP_PASSWORD_HASH=
APP_PASSWORD=

# Secreto para firmar la cookie de sesión (32+ bytes aleatorios)
AUTH_SECRET=

# Token que usa scripts/aaa_web_sync/sync.py al publicar un run
AAA_INGEST_TOKEN=
